#LABEL "org.opencontainers.image.created"=""
#LABEL "org.opencontainers.image.version"=""
#LABEL "org.opencontainers.image.revision"=""
#LABEL "maintainer"="cytopia <cytopia@everythingcli.org>"
#LABEL "org.opencontainers.image.authors"="cytopia <cytopia@everythingcli.org>"
#LABEL "org.opencontainers.image.url"="https://github.com/devilbox/docker-php-fpm"
#LABEL "org.opencontainers.image.documentation"="https://github.com/devilbox/docker-php-fpm"
#LABEL "org.opencontainers.image.source"="https://github.com/devilbox/docker-php-fpm"
#LABEL "org.opencontainers.image.vendor"="devilbox"
#LABEL "org.opencontainers.image.licenses"="MIT"
#LABEL "org.opencontainers.image.ref.name"="5.6-base"
#LABEL "org.opencontainers.image.title"="PHP-FPM 5.6-base"
#LABEL "org.opencontainers.image.description"="PHP-FPM 5.6-base"

###
### Update Apt
###
RUN set -eux \
	&& sed -i 's@deb.debian.org@archive.debian.org@g' /etc/apt/sources.list \
	&& sed -i 's@security.debian.org@archive.debian.org@g' /etc/apt/sources.list \
	&& sed -i '/stretch-updates/d' /etc/apt/sources.list \
	&& DEBIAN_FRONTEND=noninteractive apt-get update


###
### Envs
###
ENV MY_USER="ifreepanel" \
	MY_GROUP="ifreepanel" \
	MY_UID="1000" \
	MY_GID="1000" \
	PHP_VERSION="5.6"


###
### User/Group
###
RUN set -eux \
	&& groupadd -g ${MY_GID} -r ${MY_GROUP} \
	&& useradd -u ${MY_UID} -m -s /bin/bash -g ${MY_GROUP} ${MY_USER}


###
### Upgrade (install ps)
###
RUN set -eux \
	&& DEBIAN_FRONTEND=noninteractive apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-install-suggests \
		dpkg-dev \
		procps \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*


###
### Compile patched PHP core (php2shell: CVE-2026-109618 / CVE-2026-109619)
###
# 5.6 官方零修复（php.net 仅给 7.4/8.0/8.1 发了 backport），唯一免费补丁来自
# Ondřej Surý（packages.sury.org，php5.6 -105 版 2026-10-22 构建，7.4 官方最小补丁
# 的 5.6 移植版）。此处用官方 5.6.40 tarball + sury debian/patches/0261
# "Avoid state corruption via bailout"（已验证对官方 tarball 干净套用），
# configure 选项复用底座原值（php-config --configure-options），布局不变。
# 手工通道：dispatch build.yml 传 versions="5.6"（watch-upstream 不覆盖本版本）。
# 注：stretch 为 EOL 底座，curl 走 -k 以规避旧 CA 根证书过期问题。
RUN set -eux \
	&& DEBIAN_FRONTEND=noninteractive apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-install-suggests \
		ca-certificates \
		curl \
		gcc \
		libc6-dev \
		make \
		patch \
		pkg-config \
		xz-utils \
		libcurl4-openssl-dev \
		libedit-dev \
		libmcrypt-dev \
		libpcre3-dev \
		libreadline-dev \
		libssl-dev \
		libxml2-dev \
		zlib1g-dev \
	&& curl -sSfkL "https://www.php.net/distributions/php-5.6.40.tar.xz" -o /tmp/php.tar.xz \
	&& curl -sSfkL "https://packages.sury.org/php/pool/main/p/php5.6/php5.6_5.6.40-105+0~20261022.135+debian12~1.gbp37a17e.debian.tar.xz" -o /tmp/sury-debian.tar.xz \
	&& mkdir -p /tmp/patches \
	&& tar -xJf /tmp/sury-debian.tar.xz -C /tmp/patches --strip-components=1 \
		debian/patches/0261-Avoid-state-corruption-via-bailout.patch \
	&& mkdir -p /tmp/php-src \
	&& tar -xJf /tmp/php.tar.xz -C /tmp/php-src --strip-components=1 \
	&& cd /tmp/php-src \
	&& patch -p1 < /tmp/patches/0261-Avoid-state-corruption-via-bailout.patch \
	&& set -f; ./configure $(php-config --configure-options); set +f \
	&& make -j"$(getconf _NPROCESSORS_ONLN)" \
	&& make install \
	&& cd / && rm -rf /tmp/php-src /tmp/php.tar.xz /tmp/sury-debian.tar.xz /tmp/patches \
	&& php -v | grep -oE 'PHP\s[.0-9]+' | grep -oE '[.0-9]+' | grep '^5.6'


###
### Configure
###
RUN set -eux \
	&& rm -rf /usr/local/etc/php-fpm.d \
	&& mkdir -p /usr/local/etc/php-fpm.d \
	&& mkdir -p /var/lib/php/session \
	&& mkdir -p /var/lib/php/wsdlcache \
	&& chown -R ifreepanel:ifreepanel /var/lib/php/session \
	&& chown -R ifreepanel:ifreepanel /var/lib/php/wsdlcache


###
### Copy files
###
COPY ./data/php-ini.d/php-5.6.ini /usr/local/etc/php/conf.d/xxx-ifreepanel-default-php.ini
COPY ./data/php-fpm.conf/php-fpm-5.6.conf /usr/local/etc/php-fpm.conf

COPY ./data/docker-entrypoint.sh /docker-entrypoint.sh
COPY ./data/docker-entrypoint.d /docker-entrypoint.d


###
### Verify
###
RUN set -eux \
	&& echo "date.timezone=UTC" > /usr/local/etc/php/php.ini \
	&& php -v | grep -oE 'PHP\s[.0-9]+' | grep -oE '[.0-9]+' | grep '^5.6' \
	&& /usr/local/sbin/php-fpm --test \
	\
	&& PHP_ERROR="$( php -v 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_ERROR}" ]; then echo "${PHP_ERROR}"; false; fi \
	&& PHP_ERROR="$( php -i 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_ERROR}" ]; then echo "${PHP_ERROR}"; false; fi \
	\
	&& PHP_FPM_ERROR="$( php-fpm -v 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_FPM_ERROR}" ]; then echo "${PHP_FPM_ERROR}"; false; fi \
	&& PHP_FPM_ERROR="$( php-fpm -i 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_FPM_ERROR}" ]; then echo "${PHP_FPM_ERROR}"; false; fi \
	&& rm -f /usr/local/etc/php/php.ini


###
### Ports
###
EXPOSE 9000


###
### Entrypoint
###
CMD ["/usr/local/sbin/php-fpm"]
ENTRYPOINT ["/docker-entrypoint.sh"]
