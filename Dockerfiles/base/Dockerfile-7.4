#LABEL "org.opencontainers.image.ref.name"="7.4-base"
#LABEL "org.opencontainers.image.title"="PHP-FPM 7.4-base"
#LABEL "org.opencontainers.image.description"="PHP-FPM 7.4-base"


###
### Update Apt
###
RUN set -eux \
	&& sed -i 's@deb.debian.org@archive.debian.org@g' /etc/apt/sources.list \
	&& sed -i 's@security.debian.org@archive.debian.org@g' /etc/apt/sources.list \
	&& sed -i '/buster-updates/d' /etc/apt/sources.list \
	&& DEBIAN_FRONTEND=noninteractive apt-get update


###
### Envs
###
ENV MY_USER="ifreepanel" \
	MY_GROUP="ifreepanel" \
	MY_UID="1000" \
	MY_GID="1000" \
	PHP_VERSION="7.4"


###
### User/Group
###
RUN set -eux \
	&& groupadd -g ${MY_GID} -r ${MY_GROUP} \
	&& useradd -u ${MY_UID} -m -s /bin/bash -g ${MY_GROUP} ${MY_USER}


###
### Upgrade (install ps)
###
RUN set -eux \
	&& DEBIAN_FRONTEND=noninteractive apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-install-suggests \
		dpkg-dev \
		procps \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*


###
### Compile patched PHP core (php2shell: CVE-2026-109618 / CVE-2026-109619)
###
# 官方 7.4 已 EOL 且 Docker 镜像永不更新，php.net 为 7.4 发布了最小 source backport：
#   分支 PHP-7.4-CVE-2026-109618-109619，头提交 712e60f9edfd03f0960fc4fc3c2c375f42b90aa2
#   （基于 7.4.33，不动扩展 ABI，分支已冻结是固定快照）。
# 此处整体编译该分支快照覆盖 /usr/local，configure 选项复用底座原值
# （php-config --configure-options），镜像布局不变，mods/prod 层无感。
# 手工通道：dispatch build.yml 传 versions="7.4"（watch-upstream 不覆盖本版本）。
# 注 1：buster 为 EOL 底座，apt 源已切 archive.debian.org（见上方 Update Apt），
#       curl 走 -k 以规避旧 CA 根证书过期问题。
# 注 2：bypanel 底座 php-config 输出尾部可能带 CFLAGS/LDFLAGS/CPPFLAGS 三组含空格的值
#       （5.6 底座实测如此，同血统底座防御性处理），直接 $(...) 展开会把 -fpic 当成
#       独立参数（configure: unrecognized option）。故只取 CFLAGS= 之前的纯 -- 选项，
#       三组 flags 单独以环境变量传入；若输出无 CFLAGS 段则原样透传，两种情况都安全。
# 注 3：dev 包按官方 docker-library php 7.4 核心依赖清单（libssl-dev 1.1 即可，
#       7.4 原生支持 OpenSSL 1.1，与 5.6 需降 1.0 不同）；bison/re2c/autoconf 供
#       buildconf 编译分支快照用（5.6 用 tarball 自带 configure 不需要）。
#       该清单已与 bypanel 5.6 实测 configure 选项（--with-mhash --enable-ftp
#       --enable-mbstring --enable-mysqlnd --with-curl --with-libedit --with-openssl
#       --with-zlib --enable-fpm）逐项核对覆盖。
RUN set -eux \
	&& DEBIAN_FRONTEND=noninteractive apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-install-suggests \
		autoconf \
		bison \
		ca-certificates \
		curl \
		gcc \
		libc6-dev \
		make \
		pkg-config \
		re2c \
		xz-utils \
		libargon2-dev \
		libcurl4-openssl-dev \
		libedit-dev \
		libonig-dev \
		libreadline-dev \
		libsodium-dev \
		libsqlite3-dev \
		libssl-dev \
		libxml2-dev \
		zlib1g-dev \
	&& curl -sSfkL "https://codeload.github.com/php/php-src/tar.gz/712e60f9edfd03f0960fc4fc3c2c375f42b90aa2" -o /tmp/php-src.tar.gz \
	&& mkdir -p /tmp/php-src \
	&& tar -xzf /tmp/php-src.tar.gz -C /tmp/php-src --strip-components=1 \
	&& cd /tmp/php-src \
	&& ./buildconf --force \
	&& CONF_OPTS="$(php-config --configure-options)" \
	&& CFLAGS="-fstack-protector-strong -fpic -fpie -O2" \
	   LDFLAGS="-Wl,-O1 -Wl,--hash-style=both -pie" \
	   CPPFLAGS="-fstack-protector-strong -fpic -fpie -O2" \
	   ./configure ${CONF_OPTS%% CFLAGS=*} \
	&& make -j"$(getconf _NPROCESSORS_ONLN)" \
	&& make install \
	&& cd / && rm -rf /tmp/php-src /tmp/php-src.tar.gz \
	&& php -v | grep -oE 'PHP\s[.0-9]+' | grep -oE '[.0-9]+' | grep '^7.4'


###
### Configure
###
RUN set -eux \
	&& rm -rf /usr/local/etc/php-fpm.d \
	&& mkdir -p /usr/local/etc/php-fpm.d \
	&& mkdir -p /var/lib/php/session \
	&& mkdir -p /var/lib/php/wsdlcache \
	&& chown -R ifreepanel:ifreepanel /var/lib/php/session \
	&& chown -R ifreepanel:ifreepanel /var/lib/php/wsdlcache


###
### Copy files
###
COPY ./data/php-ini.d/php-7.4.ini /usr/local/etc/php/conf.d/xxx-ifreepanel-default-php.ini
COPY ./data/php-fpm.conf/php-fpm-7.4.conf /usr/local/etc/php-fpm.conf

COPY ./data/docker-entrypoint.sh /docker-entrypoint.sh
COPY ./data/docker-entrypoint.d /docker-entrypoint.d


###
### Verify
###
RUN set -eux \
	&& echo "date.timezone=UTC" > /usr/local/etc/php/php.ini \
	&& php -v | grep -oE 'PHP\s[.0-9]+' | grep -oE '[.0-9]+' | grep '^7.4' \
	&& /usr/local/sbin/php-fpm --test \
	\
	&& PHP_ERROR="$( php -v 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_ERROR}" ]; then echo "${PHP_ERROR}"; false; fi \
	&& PHP_ERROR="$( php -i 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_ERROR}" ]; then echo "${PHP_ERROR}"; false; fi \
	\
	&& PHP_FPM_ERROR="$( php-fpm -v 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_FPM_ERROR}" ]; then echo "${PHP_FPM_ERROR}"; false; fi \
	&& PHP_FPM_ERROR="$( php-fpm -i 2>&1 1>/dev/null )" \
	&& if [ -n "${PHP_FPM_ERROR}" ]; then echo "${PHP_FPM_ERROR}"; false; fi \
	&& rm -f /usr/local/etc/php/php.ini


###
### Ports
###
EXPOSE 9000


###
### Entrypoint
###
CMD ["/usr/local/sbin/php-fpm"]
ENTRYPOINT ["/docker-entrypoint.sh"]
